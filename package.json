{
  "name": "figma-make-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "lint": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "verify:migrations": "node scripts/verify_migrations.cjs",
    "test": "node scripts/test-env/run.cjs unit",
    "test:edge": "node scripts/test-env/run.cjs unit",
    "test:builder": "node scripts/test-env/run.cjs unit supabase/functions/tests/pc-builder-*.test.ts",
    "test:shopify": "node scripts/test-env/run.cjs unit supabase/functions/tests/shopify-*.test.ts",
    "test:security": "node scripts/test-env/run.cjs unit supabase/functions/tests/*security*.test.ts supabase/functions/tests/*auth*.test.ts supabase/functions/tests/*webhook*.test.ts",
    "portal:dev": "npm --prefix ITHUB_ADMIN run dev",
    "portal:build": "npm --prefix ITHUB_ADMIN run build",
    "portal:typecheck": "npm --prefix ITHUB_ADMIN run typecheck",
    "test:portal": "node scripts/test-env/run.cjs unit supabase/functions/tests/staff-portal-*.test.ts",
    "test:db": "node scripts/test-env/run.cjs db",
    "test:regression": "node scripts/test-env/run.cjs regression",
    "test:env:up": "node scripts/test-env/up.cjs",
    "test:env:down": "node scripts/test-env/down.cjs",
    "test:env:status": "node scripts/test-env/status.cjs",
    "test:env:safety": "node scripts/test-env/run.cjs safety",
    "test:env:migrate": "node scripts/test-env/migrate.cjs",
    "test:env:reset-data": "node scripts/test-env/reset-data.cjs",
    "test:env:replay": "node scripts/test-env/replay.cjs --compare --plpgsql-check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/supabase-js": "^2.117.3",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.17",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.74.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
