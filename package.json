{
  "name": "figma-make-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "lint": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "verify:migrations": "node scripts/verify_migrations.cjs",
    "test": "deno test -A supabase/functions/tests/ || \"%USERPROFILE%\\.deno\\bin\\deno.exe\" test -A supabase/functions/tests/",
    "test:edge": "deno test -A supabase/functions/tests/ || \"%USERPROFILE%\\.deno\\bin\\deno.exe\" test -A supabase/functions/tests/",
    "test:builder": "deno test -A supabase/functions/tests/pc-builder-*.test.ts || \"%USERPROFILE%\\.deno\\bin\\deno.exe\" test -A supabase/functions/tests/pc-builder-*.test.ts",
    "test:shopify": "deno test -A supabase/functions/tests/shopify-*.test.ts || \"%USERPROFILE%\\.deno\\bin\\deno.exe\" test -A supabase/functions/tests/shopify-*.test.ts",
    "test:security": "deno test -A supabase/functions/tests/*security*.test.ts supabase/functions/tests/*auth*.test.ts supabase/functions/tests/*webhook*.test.ts || \"%USERPROFILE%\\.deno\\bin\\deno.exe\" test -A supabase/functions/tests/*security*.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/supabase-js": "^2.117.3",
    "@types/dompurify": "^3.0.5",
    "dompurify": "^3.4.17",
    "lenis": "^1.3.26",
    "lucide-react": "^1.49.0",
    "motion": "^13.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.18.4",
    "recharts": "^3.10.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.74.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
