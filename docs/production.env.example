# Production build variables. Copy into your host's environment settings, not into a tracked file.
# Everything named VITE_ is built into the public bundle, so only public values belong here.
# Edge Function secrets are separate: see docs/REBUILD_RUNBOOK.md.

# Storefront and Staff Portal
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Storefront only
VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
VITE_SHOPIFY_API_VERSION=
VITE_RAZORPAY_KEY_ID=
